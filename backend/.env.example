# Backend environment template
# Copy this file to .env and update the values for your local PostgreSQL instance.

# Application
APP_NAME=School Website
APP_ENV=development
DEBUG=false

# Database (PostgreSQL)
# Local: postgresql://user:password@localhost:5432/school_db
# Docker Compose: postgresql://postgres:postgres@db:5432/school_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_db

# Database pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800

# Security (must be changed in production)
SECRET_KEY=change-me-in-production-use-a-strong-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Deployment hosts
ALLOWED_HOSTS=localhost,127.0.0.1
